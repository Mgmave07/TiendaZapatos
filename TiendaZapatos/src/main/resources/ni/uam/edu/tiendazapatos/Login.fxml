<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.tiendazapatos.Controller.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="🔐 Iniciar Sesión" />
    <Label style="-fx-font-size: 14px; -fx-text-fill: gray;" text="Sistema Tienda de Zapatos" />

    <TextField fx:id="txtUsuario" promptText="Usuario" prefWidth="300"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña" prefWidth="300"/>

    <Button fx:id="btnIngresar" onAction="#handleIngresar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 30;" text="Ingresar" />

    <Label fx:id="lblMensaje" textFill="red" wrapText="true" maxWidth="300"/>
</VBox>

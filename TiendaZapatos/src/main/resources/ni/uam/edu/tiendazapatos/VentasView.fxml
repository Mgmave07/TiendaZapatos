<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="720.0" prefHeight="520.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.tiendazapatos.Controller.VentasViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Formulario de Facturación" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Fila 1: Selector de Producto del Inventario -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Producto:"/>
        <ComboBox fx:id="cmbProductos" promptText="Seleccione zapato y talla..." prefWidth="360.0" HBox.hgrow="ALWAYS"/>
        <Label text="Cant:"/>
        <TextField fx:id="txtCantidad" prefWidth="55.0" text="1"/>
        <Button text="Agregar" onAction="#agregarAlCarrito" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Fila 2: Tabla del Carrito -->
    <TableView fx:id="tablaCarrito" prefHeight="240.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto / Variante" prefWidth="310.0"/>
            <TableColumn fx:id="colPrecio" text="Precio Unit." prefWidth="100.0"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80.0"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="110.0"/>
        </columns>
    </TableView>

    <!-- Fila 3: Método de pago y Totales -->
    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <VBox spacing="6.0">
            <Label text="Método de Pago:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbMetodoPago" prefWidth="180.0"/>
            <Button text="Quitar Seleccionado" onAction="#quitarDelCarrito" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <VBox alignment="TOP_RIGHT" spacing="5.0">
            <HBox alignment="TOP_RIGHT" spacing="10.0">
                <Label text="Subtotal: $"/>
                <Label fx:id="lblSubtotal" text="0.00" style="-fx-font-weight: bold;"/>
            </HBox>
            <HBox alignment="TOP_RIGHT" spacing="10.0">
                <Label text="IVA (15%): $"/>
                <Label fx:id="lblImpuesto" text="0.00" style="-fx-font-weight: bold;"/>
            </HBox>
            <HBox alignment="TOP_RIGHT" spacing="10.0">
                <Label text="TOTAL: $"/>
                <Label fx:id="lblTotal" text="0.00" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: red;"/>
            </HBox>
        </VBox>
    </HBox>

    <!-- Fila 4: Botón Facturar -->
    <HBox alignment="CENTER_RIGHT">
        <Button text="Realizar Venta (Facturar)" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" onAction="#facturarVenta" prefHeight="40.0" prefWidth="220.0"/>
    </HBox>
</VBox>
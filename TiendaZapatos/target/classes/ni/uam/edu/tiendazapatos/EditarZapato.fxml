<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.tiendazapatos.Controller.EditarZapatoController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Editar Zapato" />

    <Label text="DATOS DEL MODELO" style="-fx-font-weight: bold; -fx-text-fill: #555555;" />
    <TextField fx:id="txtNombre" promptText="Nombre del modelo" prefWidth="350"/>
    <HBox spacing="10.0" alignment="CENTER" prefWidth="350">
        <ComboBox fx:id="cmbMarca" promptText="Selecciona una marca" HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevaMarca" onAction="#handleNuevaMarca" text="+ Nueva" style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
    </HBox>
    <HBox spacing="10.0" alignment="CENTER">
        <TextField fx:id="txtPrecioBase" promptText="Precio Base (C$)" prefWidth="170"/>
        <TextField fx:id="txtDescuento" promptText="Descuento (%)" prefWidth="170"/>
    </HBox>
    <TextArea fx:id="txtDescripcion" promptText="Descripción del producto" prefWidth="350" prefRowCount="3"/>
    <HBox spacing="10.0" alignment="CENTER">
        <Button fx:id="btnSeleccionarImagen" onAction="#handleSeleccionarImagen" text="📷 Cambiar Imagen" />
        <Label fx:id="lblNombreImagen" text="Sin imagen" textFill="#666666" />
    </HBox>

    <Label text="VARIANTE ACTUAL" style="-fx-font-weight: bold; -fx-text-fill: #555555;" />
    <HBox spacing="10.0" alignment="CENTER">
        <ComboBox fx:id="cmbGenero" promptText="Género" prefWidth="170"/>
        <ComboBox fx:id="cmbSistemaTalla" promptText="Sistema talla" prefWidth="170"/>
    </HBox>
    <HBox spacing="10.0" alignment="CENTER">
        <TextField fx:id="txtTalla" promptText="Talla" prefWidth="110"/>
        <TextField fx:id="txtColor" promptText="Color" prefWidth="110"/>
        <TextField fx:id="txtStock" promptText="Stock" prefWidth="110"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Button fx:id="btnGuardar" onAction="#handleGuardar" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;" text="💾 Guardar Cambios" />
        <Button fx:id="btnCrearVariante" onAction="#handleCrearVariante" style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;" text="🔄 Crear Variante" />
    </HBox>

    <Label fx:id="lblMensaje" textFill="red" wrapText="true" maxWidth="350"/>
    <Button onAction="#handleCancelar" style="-fx-background-color: transparent; -fx-text-fill: #f44336; -fx-underline: true;" text="Cancelar" />
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.tiendazapatos.Controller.DetalleZapatoController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

    <Label fx:id="lblTitulo" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Detalles del Zapato" />

    <ImageView fx:id="imgZapato" fitHeight="200.0" fitWidth="200.0" preserveRatio="true" />

    <VBox spacing="5.0" alignment="CENTER_LEFT">
        <Label fx:id="lblNombre" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
        <Label fx:id="lblMarca" textFill="#555555" />
        <Label fx:id="lblPrecio" style="-fx-font-size: 18px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
        <Label fx:id="lblDescripcion" wrapText="true" maxWidth="400" textFill="#666666" />
    </VBox>

    <Button onAction="#handleCerrar" text="Cerrar" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 8 25;" />
</VBox>
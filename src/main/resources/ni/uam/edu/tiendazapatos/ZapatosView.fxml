<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="12.0" prefWidth="1200" prefHeight="700"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.uam.edu.tiendazapatos.Controller.ZapatosViewController">
    <padding>
        <Insets top="18" bottom="18" left="20" right="20"/>
    </padding>

    <Label text="Inventario de Zapatos" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label text="Control por modelo, marca, talla, stock, rango de precios y género"
           style="-fx-font-size: 13px; -fx-text-fill: #606060;"/>

    <!-- Panel de filtros de búsqueda avanzados por separado -->
    <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <!-- Fila 1: Modelo, Marca, Talla, Género -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Modelo:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtModelo" promptText="Buscar por nombre de modelo..." HBox.hgrow="ALWAYS"/>

            <Label text="Marca:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbMarca" prefWidth="150"/>

            <Label text="Talla:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtTalla" promptText="Ej. 40, 9..." prefWidth="95"/>

            <Label text="Género:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbGenero" prefWidth="120"/>
        </HBox>

        <!-- Fila 2: Stock, Rango de Precio (Mín/Máx), Limpiar y Actualizar -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Stock:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cmbStock" prefWidth="155"/>

            <Label text="Rango de Precio:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtPrecioMin" promptText="Mín (C$)" prefWidth="95"/>
            <Label text="—"/>
            <TextField fx:id="txtPrecioMax" promptText="Máx (C$)" prefWidth="95"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Limpiar Filtros" onAction="#handleLimpiarFiltros"
                    style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5; -fx-padding: 6 14;"/>
            <Button text="Actualizar" onAction="#handleActualizar"
                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 6 16;"/>
        </HBox>
    </VBox>

    <TableView fx:id="tablaZapatos" VBox.vgrow="ALWAYS" prefHeight="420">
        <columns>
            <TableColumn fx:id="colNombre" text="Modelo" prefWidth="145"/>
            <TableColumn fx:id="colMarca" text="Marca" prefWidth="95"/>
            <TableColumn fx:id="colGenero" text="Género" prefWidth="85"/>
            <TableColumn fx:id="colSistemaTalla" text="Sistema" prefWidth="75"/>
            <TableColumn fx:id="colTalla" text="Talla" prefWidth="70"/>
            <TableColumn fx:id="colColor" text="Color" prefWidth="95"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="110"/>
            <TableColumn fx:id="colPrecio" text="Precio final" prefWidth="110"/>
            <TableColumn fx:id="colVentas" text="Ventas modelo" prefWidth="110"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="115"/>
        </columns>
    </TableView>

    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="btnVerDetalles" text="Ver Detalles" onAction="#handleVerDetalles"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#handleEditarZapato"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button fx:id="btnToggleActivo" text="🚫 Desactivar / Activar" onAction="#handleToggleActivoZapato"
                style="-fx-background-color: #e11d48; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
        <Button fx:id="btnAgregarZapato" text="+ Agregar Zapato" onAction="#handleAgregarZapato"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button fx:id="btnCerrarSesion" text="Cerrar Sesión" onAction="#handleCerrarSesion"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1200.0" prefHeight="720.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.uam.edu.tiendazapatos.Controller.AdminViewController"
            style="-fx-background-color: #f3f6fa;">

    <!-- Cabecera fija -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: #203247; -fx-padding: 15 22;">
            <Label text="TIENDA DE ZAPATOS"
                   style="-fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: bold;"/>
            <Label text="|  Panel de administrador"
                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAdminInfo" text="Administrador"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 13px;"/>
            <Button fx:id="btnCerrarSesion" text="Cerrar sesión"
                    onAction="#handleCerrarSesion"
                    style="-fx-background-color: #dc4545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 9 16;"/>
        </HBox>
    </top>

    <!-- Navegación lateral -->
    <left>
        <VBox spacing="10" prefWidth="230"
              style="-fx-background-color: #293f58; -fx-padding: 24 14;">
            <Label text="NAVEGACIÓN"
                   style="-fx-text-fill: #b8c8dc; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 9 6 9;"/>
            <Button fx:id="btnNavInicio" text="⌂   Inicio" onAction="#mostrarInicio" maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 7; -fx-padding: 12 16; -fx-font-size: 14px;"/>
            <Button fx:id="btnNavInventario" text="▣   Inventario" onAction="#mostrarInventario" maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12 16; -fx-font-size: 14px;"/>
            <Button fx:id="btnNavVentas" text="▤   Facturación" onAction="#mostrarVentas" maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12 16; -fx-font-size: 14px;"/>
            <Button fx:id="btnNavHistorialVentas" text="🛒   Historial de ventas" onAction="#mostrarHistorialVentas" maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12 16; -fx-font-size: 14px;"/>
            <Button fx:id="btnNavUsuarios" text="👥   Gestión de usuarios" onAction="#mostrarUsuarios" maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12 16; -fx-font-size: 14px;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Sistema de control de inventario y ventas"
                   wrapText="true"
                   style="-fx-text-fill: #b8c8dc; -fx-font-size: 11px; -fx-padding: 8;"/>
        </VBox>
    </left>

    <!-- Contenedor principal: ruta y regreso siempre disponibles -->
    <center>
        <BorderPane style="-fx-background-color: #f3f6fa;">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color: white; -fx-padding: 11 24; -fx-border-color: #e3e9f0; -fx-border-width: 0 0 1 0;">
                    <Label text="PANEL" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label text="/" style="-fx-text-fill: #94a3b8;"/>
                    <Label fx:id="lblRuta" text="Inicio" style="-fx-text-fill: #203247; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnVolver" text="← Regresar" onAction="#volverAtras"
                            visible="false" managed="false"
                            style="-fx-background-color: #e9f0f8; -fx-text-fill: #203247; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 8 17; -fx-cursor: hand;"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="panelContenido" style="-fx-background-color: #f3f6fa;">
                    <children>
                        <!-- Pantalla de Inicio -->
                        <ScrollPane fx:id="vistaInicio" fitToWidth="true"
                                    style="-fx-background: #f3f6fa; -fx-background-color: transparent;">
                            <content>
                                <VBox alignment="TOP_LEFT" spacing="24"
                                      style="-fx-padding: 28 34; -fx-background-color: #f3f6fa;">
                                    <!-- Bienvenida -->
                                    <VBox spacing="10"
                                          style="-fx-background-color: #e7f0fb; -fx-padding: 26 28; -fx-background-radius: 12; -fx-border-color: #c9ddf7; -fx-border-radius: 12;">
                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                            <Label text="CENTRO DE OPERACIONES"
                                                   style="-fx-text-fill: #2563eb; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label text="ACCESO ADMINISTRADOR"
                                                   style="-fx-text-fill: #30567f; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                        </HBox>
                                        <Label fx:id="lblBienvenida" text="¡Bienvenido!"
                                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #203247;"/>
                                        <Label text="Gestioná inventario, facturación, historial de ventas y usuarios desde un mismo lugar."
                                               wrapText="true"
                                               style="-fx-font-size: 14px; -fx-text-fill: #476581;"/>
                                        <Label fx:id="lblFechaActual" text="Fecha actual"
                                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                                    </VBox>

                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Accesos rápidos"
                                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #203247;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label text="Elegí el módulo con el que querés trabajar"
                                               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                                    </HBox>

                                    <!-- Grid de 4 tarjetas de módulos principales -->
                                    <GridPane hgap="18" vgap="18">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                            <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <!-- Tarjeta 1: Inventario -->
                                        <VBox spacing="14" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                              style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #e3e9f0; -fx-border-radius: 12;">
                                            <Label text="INVENTARIO DE PRODUCTOS"
                                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #203247;"/>
                                            <Label text="Consultá productos, modelos, tallas, colores, stock y precios con filtros avanzados."
                                                   wrapText="true" style="-fx-text-fill: #65758b; -fx-font-size: 13px;"/>
                                            <Button text="Abrir inventario" onAction="#mostrarInventario" maxWidth="Infinity"
                                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 6;"/>
                                        </VBox>

                                        <!-- Tarjeta 2: Facturación -->
                                        <VBox spacing="14" GridPane.columnIndex="1" GridPane.rowIndex="0"
                                              style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #e3e9f0; -fx-border-radius: 12;">
                                            <Label text="NUEVA FACTURACIÓN"
                                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #203247;"/>
                                            <Label text="Buscá calzado del inventario, armá el carrito y emití nuevas facturas de venta."
                                                   wrapText="true" style="-fx-text-fill: #65758b; -fx-font-size: 13px;"/>
                                            <Button text="Abrir facturación" onAction="#mostrarVentas" maxWidth="Infinity"
                                                    style="-fx-background-color: #0f9f75; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 6;"/>
                                        </VBox>

                                        <!-- Tarjeta 3: Historial de Ventas -->
                                        <VBox spacing="14" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                              style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #e3e9f0; -fx-border-radius: 12;">
                                            <Label text="HISTORIAL DE VENTAS"
                                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #203247;"/>
                                            <Label text="Consultá todas las ventas registradas, facturas emitidas y desglose de productos."
                                                   wrapText="true" style="-fx-text-fill: #65758b; -fx-font-size: 13px;"/>
                                            <Button text="Consultar historial de ventas" onAction="#mostrarHistorialVentas" maxWidth="Infinity"
                                                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 6;"/>
                                        </VBox>

                                        <!-- Tarjeta 4: Gestión de Usuarios -->
                                        <VBox spacing="14" GridPane.columnIndex="1" GridPane.rowIndex="1"
                                              style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #e3e9f0; -fx-border-radius: 12;">
                                            <Label text="GESTIÓN DE USUARIOS"
                                                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #203247;"/>
                                            <Label text="Listá usuarios registrados, modificá datos, asigná roles, activá/desactivá y eliminá."
                                                   wrapText="true" style="-fx-text-fill: #65758b; -fx-font-size: 13px;"/>
                                            <Button text="Gestionar usuarios" onAction="#mostrarUsuarios" maxWidth="Infinity"
                                                    style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand; -fx-background-radius: 6;"/>
                                        </VBox>
                                    </GridPane>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>

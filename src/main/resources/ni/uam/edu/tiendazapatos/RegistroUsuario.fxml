<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.tiendazapatos.Controller.RegistroUsuarioController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Registro de Usuario" />

    <TextField fx:id="txtUsuario" promptText="Nombre de usuario" prefWidth="300"/>
    <TextField fx:id="txtNombreCompleto" promptText="Nombre completo" prefWidth="300"/>
    <TextField fx:id="txtCorreo" promptText="Correo electrónico" prefWidth="300"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña" prefWidth="300"/>
    <TextField fx:id="txtTelefono" promptText="Teléfono" prefWidth="300"/>

    <Button fx:id="btnGuardar" onAction="#handleGuardar" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20;" text="Guardar en Base de Datos" />

    <Label fx:id="lblMensaje" textFill="red" wrapText="true" maxWidth="300"/>
</VBox>

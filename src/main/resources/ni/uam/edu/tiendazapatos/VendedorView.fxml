<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="800" prefHeight="550"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.uam.edu.tiendazapatos.Controller.VendedorViewController"
      style="-fx-background-color: #f8f9fa;">
    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>

    <!-- Título de bienvenida -->
    <Label text="👋 Vista de Vendedor"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label fx:id="lblBienvenida" text="¡Bienvenido al sistema!"
           style="-fx-font-size: 18px; -fx-text-fill: #34495e;"/>

    <Label text="Módulo de ventas en blanco (Espacio de trabajo para el vendedor)"
           style="-fx-font-size: 14px; -fx-text-fill: #95a5a6; -fx-font-style: italic;"/>

    <Region prefHeight="30"/>

    <!-- Botón de cerrar sesión -->
    <Button fx:id="btnCerrarSesion" text="Cerrar Sesión" onAction="#handleCerrarSesion"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 5; -fx-cursor: hand;"/>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ni.uam.edu.tiendazapatos.Controller.LoginController"
           prefWidth="520.0" prefHeight="640.0"
           style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b, #0f172a);">

    <!-- Contenedor central con tarjeta moderna -->
    <VBox alignment="CENTER" maxWidth="420.0" spacing="22.0"
          style="-fx-background-color: #1e293b; -fx-background-radius: 16;
                 -fx-border-color: #334155; -fx-border-width: 1.5; -fx-border-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 24, 0, 0, 10);
                 -fx-padding: 38 34;">

        <!-- Badge de la Marca / Encabezado -->
        <VBox alignment="CENTER" spacing="8">
            <HBox alignment="CENTER" spacing="8">
                <Label text="👟" style="-fx-font-size: 26px;"/>
                <Label text="TIENDA DE ZAPATOS"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #38bdf8;
                              -fx-background-color: rgba(56,189,248,0.12); -fx-background-radius: 20;
                              -fx-padding: 4 12; -fx-border-color: rgba(56,189,248,0.3); -fx-border-radius: 20;"/>
            </HBox>

            <Label text="Iniciar Sesión"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 6 0 0 0;"/>
            <Label text="Ingresa tus credenciales para acceder al sistema"
                   style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
        </VBox>

        <!-- Formulario -->
        <VBox spacing="14.0" alignment="CENTER_LEFT">

            <!-- Campo Usuario -->
            <VBox spacing="5">
                <Label text="Nombre de Usuario" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;"/>
                <TextField fx:id="txtUsuario" promptText="Ingresa tu usuario..."
                           maxWidth="Infinity" prefHeight="42"
                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #64748b;
                                  -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;
                                  -fx-padding: 0 14; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Campo Contraseña -->
            <VBox spacing="5">
                <Label text="Contraseña" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #cbd5e1;"/>
                <PasswordField fx:id="txtPassword" promptText="••••••••"
                               maxWidth="Infinity" prefHeight="42"
                               style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #64748b;
                                      -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 0 14; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Mensaje de Error / Feedback -->
            <Label fx:id="lblMensaje" text="" wrapText="true" maxWidth="Infinity"
                   visible="false" managed="false"
                   style="-fx-font-size: 12px; -fx-text-fill: #f87171; -fx-background-color: rgba(239,68,68,0.12);
                          -fx-padding: 8 12; -fx-background-radius: 6; -fx-border-color: rgba(239,68,68,0.3);
                          -fx-border-radius: 6;"/>

            <!-- Botón de Ingreso -->
            <Button fx:id="btnIngresar" text="Acceder al Sistema →" onAction="#handleIngresar"
                    maxWidth="Infinity" prefHeight="44"
                    style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(2,132,199,0.35), 8, 0, 0, 3);"/>
        </VBox>

        <!-- Pie de tarjeta -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="Sistema de Control POS y Gestión v2.0"
                   style="-fx-font-size: 11px; -fx-text-fill: #475569;"/>
        </HBox>
    </VBox>
</StackPane>

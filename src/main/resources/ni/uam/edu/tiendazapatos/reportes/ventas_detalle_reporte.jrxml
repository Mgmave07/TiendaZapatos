<?xml version="1.0" encoding="UTF-8"?>
<!--
  ventas_detalle_reporte.jrxml
  ============================================================
  REPORTE DE VENTAS POR PRODUCTO — TiendaZapatos
  Muestra UNA FILA POR ARTÍCULO VENDIDO, agrupada por factura.
  Diferencia clave respecto a ventas_reporte.jrxml:
    • ventas_reporte        → 1 fila por FACTURA (resumen)
    • ventas_detalle_reporte → 1 fila por LÍNEA DE PRODUCTO (desglose)
  ============================================================
  Fuente de datos : JRBeanCollectionDataSource<DetalleVentaReporteItem>
  Parámetros      : NOMBRE_TIENDA, TITULO_REPORTE, FECHA_GENERACION,
                    GENERADO_POR, RANGO_FECHAS,
                    TOTAL_FACTURAS (Integer), GRAN_TOTAL_IVA (Double),
                    GRAN_TOTAL (Double)
  Campos          : numeroVenta, fechaVenta, vendedor, metodoPago,
                    ivaVenta, totalVenta, producto, variante,
                    cantidad, precioUnitario, subtotalLinea
  Orientación     : Landscape  792 × 612 pts
  ============================================================
-->
<jasperReport name="ventas_detalle_reporte" language="java"
              pageWidth="792" pageHeight="612" orientation="Landscape"
              columnWidth="752" leftMargin="20" rightMargin="20"
              topMargin="20"  bottomMargin="20"
              uuid="d4040000-4444-4000-8000-000000000001">

    <!-- ═══════════════ PARÁMETROS ═══════════════ -->
    <parameter name="NOMBRE_TIENDA"    class="java.lang.String"/>
    <parameter name="TITULO_REPORTE"   class="java.lang.String"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>
    <parameter name="GENERADO_POR"     class="java.lang.String"/>
    <parameter name="RANGO_FECHAS"     class="java.lang.String"/>
    <parameter name="TOTAL_FACTURAS"   class="java.lang.Integer"/>
    <parameter name="GRAN_TOTAL_IVA"   class="java.lang.Double"/>
    <parameter name="GRAN_TOTAL"       class="java.lang.Double"/>

    <!-- ═══════════════ CAMPOS (coinciden con getters de DetalleVentaReporteItem) ═══════════════ -->
    <field name="numeroVenta"    class="java.lang.String"/>
    <field name="fechaVenta"     class="java.lang.String"/>
    <field name="vendedor"       class="java.lang.String"/>
    <field name="metodoPago"     class="java.lang.String"/>
    <field name="ivaVenta"       class="java.lang.Double"/>
    <field name="totalVenta"     class="java.lang.Double"/>
    <field name="producto"       class="java.lang.String"/>
    <field name="variante"       class="java.lang.String"/>
    <field name="cantidad"       class="java.lang.Integer"/>
    <field name="precioUnitario" class="java.lang.Double"/>
    <field name="subtotalLinea"  class="java.lang.Double"/>

    <!-- ═══════════════ VARIABLES ═══════════════ -->
    <!-- Acumuladores por grupo (se reinician en cada nueva factura) -->
    <variable name="SUM_CANT_GRUPO"      class="java.lang.Integer" calculation="Sum"
              resetType="Group" resetGroup="GrupoFactura">
        <expression><![CDATA[$F{cantidad} == null ? 0 : $F{cantidad}]]></expression>
    </variable>
    <variable name="SUM_SUBTOTAL_GRUPO"  class="java.lang.Double"  calculation="Sum"
              resetType="Group" resetGroup="GrupoFactura">
        <expression><![CDATA[$F{subtotalLinea} == null ? 0.0 : $F{subtotalLinea}]]></expression>
    </variable>

    <!-- Acumuladores globales -->
    <variable name="SUM_CANT_TOTAL"      class="java.lang.Integer" calculation="Sum">
        <expression><![CDATA[$F{cantidad} == null ? 0 : $F{cantidad}]]></expression>
    </variable>
    <variable name="SUM_SUBTOTAL_TOTAL"  class="java.lang.Double"  calculation="Sum">
        <expression><![CDATA[$F{subtotalLinea} == null ? 0.0 : $F{subtotalLinea}]]></expression>
    </variable>

    <!-- ═══════════════ GRUPO POR FACTURA ═══════════════ -->
    <group name="GrupoFactura">
        <expression><![CDATA[$F{numeroVenta}]]></expression>

        <!-- ENCABEZADO DE FACTURA: aparece una vez por número de factura -->
        <groupHeader>
            <band height="46" splitType="Stretch">
                <!-- Fila 1: datos de la factura (fondo azul oscuro) -->
                <element kind="rectangle" uuid="d4040000-4444-4000-8000-000000000101"
                         x="0" y="2" width="752" height="22" backcolor="#293F58">
                    <pen lineWidth="0.0"/>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000102"
                         x="6" y="2" width="200" height="22"
                         forecolor="#FFFFFF" fontName="SansSerif" fontSize="8.5" bold="true" vTextAlign="Middle">
                    <expression><![CDATA["N° Factura: " + $F{numeroVenta}]]></expression>
                    <box leftPadding="4"/>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000103"
                         x="206" y="2" width="165" height="22"
                         forecolor="#CBD5E1" fontName="SansSerif" fontSize="8.5" vTextAlign="Middle">
                    <expression><![CDATA["Fecha: " + $F{fechaVenta}]]></expression>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000104"
                         x="371" y="2" width="220" height="22"
                         forecolor="#CBD5E1" fontName="SansSerif" fontSize="8.5" vTextAlign="Middle">
                    <expression><![CDATA["Vendedor: " + $F{vendedor}]]></expression>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000105"
                         x="591" y="2" width="157" height="22"
                         forecolor="#93C5FD" fontName="SansSerif" fontSize="8.5" hTextAlign="Right" vTextAlign="Middle">
                    <expression><![CDATA["Método: " + $F{metodoPago}]]></expression>
                    <box rightPadding="4"/>
                </element>

                <!-- Fila 2: encabezados de columnas de producto -->
                <element kind="staticText" uuid="d4040000-4444-4000-8000-000000000110"
                         mode="Opaque" x="0" y="24" width="310" height="20"
                         backcolor="#EFF6FF" forecolor="#334155"
                         fontName="SansSerif" fontSize="8.0" bold="true" vTextAlign="Middle">
                    <text><![CDATA[Producto / Modelo (Marca)]]></text>
                    <box leftPadding="6" rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                </element>
                <element kind="staticText" uuid="d4040000-4444-4000-8000-000000000111"
                         mode="Opaque" x="310" y="24" width="162" height="20"
                         backcolor="#EFF6FF" forecolor="#334155"
                         fontName="SansSerif" fontSize="8.0" bold="true" vTextAlign="Middle">
                    <text><![CDATA[Variante (Género/Talla/Color)]]></text>
                    <box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                </element>
                <element kind="staticText" uuid="d4040000-4444-4000-8000-000000000112"
                         mode="Opaque" x="472" y="24" width="48" height="20"
                         backcolor="#EFF6FF" forecolor="#334155"
                         fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
                    <text><![CDATA[Cant.]]></text>
                    <box leftPadding="2" rightPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                </element>
                <element kind="staticText" uuid="d4040000-4444-4000-8000-000000000113"
                         mode="Opaque" x="520" y="24" width="110" height="20"
                         backcolor="#EFF6FF" forecolor="#334155"
                         fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
                    <text><![CDATA[Precio Unitario]]></text>
                    <box leftPadding="4" rightPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                </element>
                <element kind="staticText" uuid="d4040000-4444-4000-8000-000000000114"
                         mode="Opaque" x="630" y="24" width="122" height="20"
                         backcolor="#EFF6FF" forecolor="#334155"
                         fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
                    <text><![CDATA[Subtotal Línea]]></text>
                    <box leftPadding="4" rightPadding="6"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                </element>
            </band>
        </groupHeader>

        <!-- PIE DE FACTURA: totales de esta factura -->
        <groupFooter>
            <band height="28" splitType="Stretch">
                <element kind="rectangle" uuid="d4040000-4444-4000-8000-000000000120"
                         x="0" y="2" width="752" height="22" backcolor="#F1F5F9">
                    <pen lineWidth="0.5" lineColor="#CBD5E1"/>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000121"
                         x="6" y="2" width="300" height="22"
                         forecolor="#475569" fontName="SansSerif" fontSize="8.0" bold="true" vTextAlign="Middle">
                    <expression><![CDATA["Artículos de esta factura: " + $V{SUM_CANT_GRUPO}]]></expression>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000122"
                         x="306" y="2" width="166" height="22"
                         forecolor="#334155" fontName="SansSerif" fontSize="8.0" bold="true"
                         hTextAlign="Right" vTextAlign="Middle" pattern="'Subtotal: C$ '#,##0.00">
                    <expression><![CDATA[$V{SUM_SUBTOTAL_GRUPO}]]></expression>
                    <box rightPadding="6"/>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000123"
                         x="472" y="2" width="140" height="22"
                         forecolor="#334155" fontName="SansSerif" fontSize="8.0" bold="true"
                         hTextAlign="Right" vTextAlign="Middle" pattern="'IVA 15%: C$ '#,##0.00">
                    <expression><![CDATA[$F{ivaVenta}]]></expression>
                    <box rightPadding="6"/>
                </element>
                <element kind="textField" uuid="d4040000-4444-4000-8000-000000000124"
                         x="612" y="2" width="136" height="22"
                         forecolor="#0F766E" fontName="SansSerif" fontSize="9.0" bold="true"
                         hTextAlign="Right" vTextAlign="Middle" pattern="'TOTAL: C$ '#,##0.00">
                    <expression><![CDATA[$F{totalVenta}]]></expression>
                    <box rightPadding="6"/>
                </element>
            </band>
        </groupFooter>
    </group>

    <!-- ═══════════════ TÍTULO (una sola vez, al inicio del reporte) ═══════════════ -->
    <title height="88" splitType="Stretch">
        <element kind="rectangle" uuid="d4040000-4444-4000-8000-000000000002"
                 x="0" y="0" width="752" height="78" backcolor="#203247">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000003"
                 x="14" y="8" width="440" height="24"
                 forecolor="#FFFFFF" fontName="SansSerif" fontSize="16.0" bold="true" vTextAlign="Middle">
            <expression><![CDATA[$P{NOMBRE_TIENDA}]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000004"
                 x="14" y="34" width="440" height="20"
                 forecolor="#CBD5E1" fontName="SansSerif" fontSize="11.0" bold="true" vTextAlign="Middle">
            <expression><![CDATA[$P{TITULO_REPORTE}]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000005"
                 x="14" y="54" width="440" height="18"
                 forecolor="#93C5FD" fontName="SansSerif" fontSize="9.0" vTextAlign="Middle">
            <expression><![CDATA["Período: " + $P{RANGO_FECHAS}]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000006"
                 x="465" y="12" width="273" height="20"
                 forecolor="#E2E8F0" fontName="SansSerif" fontSize="9.5" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["Fecha: " + $P{FECHA_GENERACION}]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000007"
                 x="465" y="36" width="273" height="20"
                 forecolor="#CBD5E1" fontName="SansSerif" fontSize="9.5" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["Generado por: " + $P{GENERADO_POR}]]></expression>
        </element>
    </title>

    <!-- ═══════════════ DETALLE (una fila por línea de producto) ═══════════════ -->
    <detail>
        <band height="20" splitType="Stretch">
            <element kind="textField" uuid="d4040000-4444-4000-8000-000000000020"
                     x="0" y="0" width="310" height="20"
                     fontName="SansSerif" fontSize="8.5" vTextAlign="Middle"
                     textAdjust="StretchHeight" stretchType="ElementGroupHeight" blankWhenNull="true">
                <expression><![CDATA[$F{producto}]]></expression>
                <box topPadding="3" bottomPadding="3" leftPadding="6" rightPadding="4">
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
            </element>
            <element kind="textField" uuid="d4040000-4444-4000-8000-000000000021"
                     x="310" y="0" width="162" height="20"
                     fontName="SansSerif" fontSize="8.0" vTextAlign="Middle"
                     textAdjust="StretchHeight" stretchType="ElementGroupHeight" blankWhenNull="true">
                <expression><![CDATA[$F{variante}]]></expression>
                <box topPadding="3" bottomPadding="3" leftPadding="4" rightPadding="4">
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
            </element>
            <element kind="textField" uuid="d4040000-4444-4000-8000-000000000022"
                     x="472" y="0" width="48" height="20"
                     fontName="SansSerif" fontSize="8.5" hTextAlign="Right" vTextAlign="Middle"
                     pattern="#,##0" stretchType="ElementGroupHeight" blankWhenNull="true">
                <expression><![CDATA[$F{cantidad}]]></expression>
                <box topPadding="3" bottomPadding="3" leftPadding="2" rightPadding="6">
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
            </element>
            <element kind="textField" uuid="d4040000-4444-4000-8000-000000000023"
                     x="520" y="0" width="110" height="20"
                     fontName="SansSerif" fontSize="8.5" hTextAlign="Right" vTextAlign="Middle"
                     pattern="C$ #,##0.00" stretchType="ElementGroupHeight" blankWhenNull="true">
                <expression><![CDATA[$F{precioUnitario}]]></expression>
                <box topPadding="3" bottomPadding="3" leftPadding="4" rightPadding="6">
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
            </element>
            <element kind="textField" uuid="d4040000-4444-4000-8000-000000000024"
                     x="630" y="0" width="122" height="20"
                     fontName="SansSerif" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle"
                     pattern="C$ #,##0.00" stretchType="ElementGroupHeight" blankWhenNull="true">
                <expression><![CDATA[$F{subtotalLinea}]]></expression>
                <box topPadding="3" bottomPadding="3" leftPadding="4" rightPadding="6">
                    <bottomPen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
            </element>
        </band>
    </detail>

    <!-- ═══════════════ PIE DE PÁGINA ═══════════════ -->
    <pageFooter height="24" splitType="Stretch">
        <element kind="staticText" uuid="d4040000-4444-4000-8000-000000000030"
                 x="0" y="6" width="460" height="16"
                 forecolor="#64748B" fontName="SansSerif" fontSize="8.5" vTextAlign="Middle">
            <text><![CDATA[Tienda de Zapatos — Reporte de Ventas por Producto generado desde el Panel de Administrador]]></text>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000031"
                 x="580" y="6" width="124" height="16"
                 forecolor="#64748B" fontName="SansSerif" fontSize="8.5" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000032"
                 x="708" y="6" width="44" height="16"
                 forecolor="#64748B" fontName="SansSerif" fontSize="8.5"
                 evaluationTime="Report" hTextAlign="Left" vTextAlign="Middle">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

    <!-- ═══════════════ RESUMEN (totales globales, última página) ═══════════════ -->
    <summary height="80" splitType="Stretch">
        <element kind="rectangle" uuid="d4040000-4444-4000-8000-000000000040"
                 x="0" y="10" width="752" height="62" backcolor="#F1F5F9">
            <pen lineWidth="0.75" lineColor="#CBD5E1"/>
        </element>

        <!-- Fila 1: conteos -->
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000041"
                 x="14" y="14" width="200" height="18"
                 forecolor="#203247" fontName="SansSerif" fontSize="9.5" bold="true" vTextAlign="Middle">
            <expression><![CDATA["Total facturas: " + $P{TOTAL_FACTURAS}]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000042"
                 x="14" y="34" width="200" height="18"
                 forecolor="#203247" fontName="SansSerif" fontSize="9.5" bold="true" vTextAlign="Middle">
            <expression><![CDATA["Líneas de producto: " + $V{REPORT_COUNT}]]></expression>
        </element>
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000043"
                 x="14" y="54" width="200" height="18"
                 forecolor="#203247" fontName="SansSerif" fontSize="9.5" bold="true" vTextAlign="Middle">
            <expression><![CDATA["Total unidades vendidas: " + $V{SUM_CANT_TOTAL}]]></expression>
        </element>

        <!-- Fila 1 derecha: Subtotal de líneas -->
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000044"
                 x="230" y="20" width="200" height="24"
                 forecolor="#334155" fontName="SansSerif" fontSize="9.5" bold="true"
                 hTextAlign="Right" vTextAlign="Middle" pattern="'Subtotal líneas: C$ '#,##0.00">
            <expression><![CDATA[$V{SUM_SUBTOTAL_TOTAL}]]></expression>
        </element>

        <!-- IVA total (pasado como parámetro desde Java para evitar doble conteo) -->
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000045"
                 x="440" y="20" width="168" height="24"
                 forecolor="#334155" fontName="SansSerif" fontSize="9.5" bold="true"
                 hTextAlign="Right" vTextAlign="Middle" pattern="'IVA total: C$ '#,##0.00">
            <expression><![CDATA[$P{GRAN_TOTAL_IVA}]]></expression>
        </element>

        <!-- Total con IVA (parámetro) -->
        <element kind="textField" uuid="d4040000-4444-4000-8000-000000000046"
                 x="608" y="14" width="136" height="34"
                 forecolor="#0F766E" fontName="SansSerif" fontSize="11.0" bold="true"
                 hTextAlign="Right" vTextAlign="Middle" pattern="'TOTAL: C$ '#,##0.00">
            <expression><![CDATA[$P{GRAN_TOTAL}]]></expression>
            <box rightPadding="6"/>
        </element>
    </summary>

</jasperReport>
